{
  "name": "garmin-workout-editor",
  "version": "1.0.0",
  "description": "Extract Garmin activities and manage workouts",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/web/public','dist/web/public',{recursive:true})\"",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:http": "tsx src/mcp/server.ts --http",
    "web": "tsx src/web/server.ts",
    "store": "tsx src/storeCli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@flow-js/garmin-connect": "^1.6.24",
    "@garmin/fitsdk": "^21.218.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@zxing/library": "0.21.3",
    "dotenv": "^16.3.1",
    "leaflet": "^1.9.4",
    "monaco-editor": "0.52.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^24.19.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
