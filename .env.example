GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD="your_password"
# Note: Always quote passwords that contain special characters like # % & etc.
# Otherwise, dotenv will treat them as comments and truncate the password

# ─── LLM auth (need at least one) ─────────────────────────────────────────────
# Option 1: GitHub PAT with an active Copilot subscription
#   Create at: https://github.com/settings/tokens (no special scopes required)
GITHUB_TOKEN=ghp_...

# Option 2: BYOK — OpenAI
# OPENAI_API_KEY=sk-...

# Option 3: BYOK — Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default Copilot model
# COPILOT_MODEL=claude-sonnet-4-5
