## ─── Multi-Profile Setup ──────────────────────────────────────────────────────
## Create one .env.<profile> file per Garmin account:
##   .env.MED       → your account
##   .env.Julie     → your wife's account
##
## Each file needs GARMIN_EMAIL and GARMIN_PASSWORD at minimum.
## Data is stored in data/<profile>/ (e.g., data/MED/, data/Julie/).
##
## Usage:
##   npm run mcp -- --profile Julie
## ──────────────────────────────────────────────────────────────────────────────

GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD="your_password"
# Note: Always quote passwords that contain special characters like # % & etc.
# Otherwise, dotenv will treat them as comments and truncate the password

# ─── MCP server (claude.ai / Claude Desktop) ──────────────────────────────────
# See "MCP Server" in README.md. In Docker these go in the compose .env file.

# Required for HTTP mode, at least 32 characters:  openssl rand -hex 32
# MCP_AUTH_TOKEN=
# Profile used when a tool call doesn't name one (optional if you have only one)
# GARMIN_PROFILE=MED
# MCP_PORT=8787
# MCP_HOST=127.0.0.1

# Plan editor web UI (npm run web); a token is required when WEB_HOST is not loopback
# WEB_PORT=8788
# WEB_HOST=127.0.0.1
# WEB_AUTH_TOKEN=                 # admin login (any user name); per-profile logins use WEB_PASSWORD in .env.<profile>

# Docker compose only
# PUID=1000
# PGID=1000
# MCP_BIND=127.0.0.1
# WEB_BIND=127.0.0.1
# (compose also reads WEB_AUTH_TOKEN and WEB_PORT from above; WEB_AUTH_TOKEN is required)
# TUNNEL_TOKEN=

# Directory overrides (set by the Docker image; defaults match the CLI layout)
# GARMIN_PROFILES_DIR=/config     # where .env.<profile> files live (default: project root)
# GARMIN_DATA_DIR=/data           # per-profile data root           (default: <project>/data)
# GARMIN_STORE_PATH=/data/garmin.db  # the SQLite database          (default: <GARMIN_DATA_DIR>/garmin.db)
